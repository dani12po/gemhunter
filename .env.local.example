# =============================================================
# .env.local.example — Solana Gem Hunter
# Salin file ini: cp .env.local.example .env.local
# Isi nilainya sesuai kebutuhan
# JANGAN commit .env.local ke GitHub
# =============================================================

# ─── NETWORK ─────────────────────────────────────────────────
# Pilih jaringan: devnet | mainnet-beta
# devnet  = testing gratis, tidak pakai SOL asli
# mainnet-beta = production, pakai SOL asli
NEXT_PUBLIC_NETWORK=devnet

# ─── RPC ENDPOINTS ───────────────────────────────────────────
# Jika kosong, otomatis pakai clusterApiUrl sesuai NETWORK di atas
#
# Mainnet — gunakan provider berbayar untuk produksi (lebih stabil):
# Helius (recommended): https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Alchemy: https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# QuickNode: https://YOUR_ENDPOINT.solana-mainnet.quiknode.pro/YOUR_KEY
# Gratis (rate-limited): https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_URL=

# Devnet — untuk testing
# Helius devnet: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Gratis: https://api.devnet.solana.com
NEXT_PUBLIC_DEVNET_RPC_URL=

# ─── JUPITER API ─────────────────────────────────────────────
# API Key Jupiter (opsional) — tanpa key tetap bisa swap tapi rate-limited
# Daftar gratis di: https://portal.jup.ag
# Dengan key: rate limit lebih tinggi + priority routing
NEXT_PUBLIC_JUPITER_API_KEY=

# ─── PLATFORM FEE WALLET ─────────────────────────────────────
# Wallet Solana penerima fee 0.5% dari setiap swap
# Sudah di-hardcode di src/lib/constants.ts, tapi bisa override di sini
# Untuk aktivasi: daftar di https://station.jup.ag sebagai referral account
NEXT_PUBLIC_PLATFORM_FEE_WALLET=YOUR_SOLANA_WALLET_ADDRESS

# ─── PINATA IPFS (untuk Upload Logo Token) ───────────────────
# Digunakan di fitur Create Token untuk upload logo ke IPFS
# Daftar gratis di: https://app.pinata.cloud/developers/api-keys
# Tanpa ini, upload logo tidak akan berfungsi
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# ─── CATATAN UNTUK VERCEL DEPLOYMENT ─────────────────────────
# Tambahkan semua variabel di atas ke:
# Vercel Dashboard → Project → Settings → Environment Variables
#
# NEXT_PUBLIC_* → bisa diset untuk Production, Preview, Development
# PINATA_*      → server-side only, set untuk Production saja
#
# Minimal yang WAJIB diset di Vercel:
# - NEXT_PUBLIC_NETWORK
# - NEXT_PUBLIC_RPC_URL (gunakan Helius/Alchemy untuk production)
# - NEXT_PUBLIC_PLATFORM_FEE_WALLET
# - PINATA_API_KEY + PINATA_SECRET_KEY (jika pakai fitur Create Token)